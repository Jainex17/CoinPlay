# Do not commit a real .env file.
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://user:password@localhost:5432/coinplay
JWT_SECRET=replace-with-a-random-64-character-secret
# Set in production when the database provider uses a private CA. Newlines may be written as \n.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
