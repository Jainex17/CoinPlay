{
  "name": "coinplay-backend",
  "version": "1.0.0",
  "description": "Simple Express TypeScript backend server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "pnpm run build && node --test dist/tests/tradingMath.test.js",
    "benchmark:coin-lock": "pnpm run build && node dist/tools/coinLockBenchmark.js",
    "benchmark:http-trades": "pnpm run build && node dist/tools/httpTradeBenchmark.js",
    "migrate": "pnpm run build && node dist/tools/migrate.js",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.5.0",
    "@types/pg": "^8.15.4",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
